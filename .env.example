# ==============================================================================
# COLLEGE EVENT PORTAL (ESEC FIESTA 2026) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node.js Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Google Cloud Storage (GCS)
# Service Account credentials for signed URL generation
GCS_BUCKET_NAME=college-event-esec-receipts
GCS_PROJECT_ID=esec-events-2026
GCS_CLIENT_EMAIL=event-uploader@esec-events-2026.iam.gserviceaccount.com
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Supabase Database & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Client Config
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:5000/api
